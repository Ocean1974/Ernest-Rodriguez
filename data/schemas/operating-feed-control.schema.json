{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/operating-feed-control.schema.json",
  "title": "White Rabbit Operating Feed and Close Controls",
  "oneOf": [{ "$ref": "#/$defs/record" }, { "$ref": "#/$defs/checkpoint" }, { "$ref": "#/$defs/batch" }, { "$ref": "#/$defs/reconciliation" }, { "$ref": "#/$defs/application" }, { "$ref": "#/$defs/period" }, { "$ref": "#/$defs/correction" }, { "$ref": "#/$defs/restatement" }, { "$ref": "#/$defs/reforecast" }, { "$ref": "#/$defs/state" }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "assetId", "kind", "sequence", "effectiveAt", "payloadId", "payloadSha256", "payload", "source", "recordSha256"], "properties": { "schemaVersion": { "const": "wr-operating-feed-record-v1" }, "kind": { "enum": ["lease", "lease-amendment", "operating-statement", "asset-budget", "capital-project", "forecast-assumption"] }, "recordSha256": { "$ref": "#/$defs/digest" } } },
    "checkpoint": { "type": "object", "required": ["schemaVersion", "organizationId", "datasetId", "lastSequence", "lastCursor", "acceptedRecordCount", "updatedAt"], "properties": { "schemaVersion": { "const": "wr-operating-feed-checkpoint-v1" }, "lastSequence": { "type": "integer", "minimum": -1 } } },
    "batch": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "datasetId", "asOf", "acceptedRecordIds", "acceptedRecordSha256s", "quarantined", "replayed", "checkpoint", "accepted", "stats", "batchSha256"], "properties": { "schemaVersion": { "const": "wr-operating-feed-batch-v1" }, "batchSha256": { "$ref": "#/$defs/digest" } } },
    "reconciliation": { "type": "object", "required": ["schemaVersion", "organizationId", "datasetId", "batchId", "batchSha256", "reconciledAt", "status", "items", "stats", "reportSha256"], "properties": { "schemaVersion": { "const": "wr-operating-reconciliation-report-v1" }, "status": { "enum": ["matched", "changes-required", "conflicted"] }, "reportSha256": { "$ref": "#/$defs/digest" } } },
    "application": { "type": "object", "required": ["schemaVersion", "organizationId", "appliedAt", "applicationSha256"], "properties": { "schemaVersion": { "const": "wr-operating-feed-application-v1" }, "applicationSha256": { "$ref": "#/$defs/digest" } } },
    "period": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "assetId", "periodStart", "periodEnd", "status", "createdByUserId", "softClosedByUserId", "softClosedAt", "hardClosedByUserId", "hardClosedAt", "closeEvidenceRefs", "periodSha256"], "properties": { "schemaVersion": { "const": "wr-accounting-period-v1" }, "status": { "enum": ["open", "soft-closed", "hard-closed"] }, "periodSha256": { "$ref": "#/$defs/digest" } } },
    "correction": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "assetId", "accountingPeriodId", "targetRecordId", "targetRecordSha256", "targetPayloadId", "targetPayloadSha256", "replacementRecord", "reason", "evidenceRefs", "status", "proposedByUserId", "proposedAt", "reviewedByUserId", "reviewedAt", "reviewComment", "appliedAt", "correctionSha256"], "properties": { "schemaVersion": { "const": "wr-operating-correction-v1" }, "status": { "enum": ["proposed", "restatement-required", "approved", "applied", "rejected"] }, "correctionSha256": { "$ref": "#/$defs/digest" } } },
    "restatement": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "assetId", "accountingPeriodId", "correctionIds", "reason", "impactSummary", "status", "requestedByUserId", "requestedAt", "approvedByUserId", "approvedAt", "approvalComment", "appliedAt", "restatementSha256"], "properties": { "schemaVersion": { "const": "wr-operating-restatement-v1" }, "status": { "enum": ["proposed", "approved", "applied", "rejected"] }, "restatementSha256": { "$ref": "#/$defs/digest" } } },
    "reforecast": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "assetId", "baseForecastSha256", "triggerType", "correctionIds", "restatementIds", "changedAssumptionSha256s", "reason", "status", "requestedByUserId", "requestedAt", "approvedByUserId", "approvedAt", "approvalComment", "generatedForecastSha256", "requestSha256"], "properties": { "schemaVersion": { "const": "wr-reforecast-request-v1" }, "status": { "enum": ["proposed", "approved", "generated", "rejected"] }, "requestSha256": { "$ref": "#/$defs/digest" } } },
    "state": { "type": "object", "required": ["schemaVersion", "organizationId", "revision", "accountingPeriods", "corrections", "restatements", "reforecasts", "updatedAt", "stateSha256"], "properties": { "schemaVersion": { "const": "wr-operating-control-state-v1" }, "stateSha256": { "$ref": "#/$defs/digest" } } }
  }
}
