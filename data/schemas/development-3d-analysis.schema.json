{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/development-3d-analysis.schema.json",
  "title": "White Rabbit 3D Development Analysis Contracts",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["value", "unit", "source", "sourceField", "asOf", "confidence", "status"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["observed", "defaulted", "derived", "unknown"] }
      }
    },
    "siteModel": {
      "type": "object",
      "required": ["schemaVersion", "whiteRabbitPropertyId", "siteAreaSqFt", "terrain", "existingBuildings", "constraints", "status", "missingEvidence"],
      "properties": {
        "schemaVersion": { "const": "wr-development-site-model-v1" },
        "whiteRabbitPropertyId": { "type": "string", "pattern": "^wrp:v1:[^:]+:.+$" },
        "siteAreaSqFt": { "$ref": "#/$defs/evidence" },
        "status": { "enum": ["ready", "partial"] }
      }
    },
    "feasibility": {
      "type": "object",
      "required": ["schemaVersion", "whiteRabbitPropertyId", "status", "site", "proposal", "metrics", "checks", "missingEvidence", "disclaimer"],
      "properties": {
        "schemaVersion": { "const": "wr-development-feasibility-v1" },
        "status": { "enum": ["feasible", "not-feasible", "indeterminate", "insufficient-evidence"] },
        "checks": { "type": "array", "items": { "type": "object", "properties": { "status": { "enum": ["pass", "fail", "unknown"] } } } }
      }
    },
    "shadow": { "type": "object", "properties": { "schemaVersion": { "const": "wr-shadow-analysis-v1" }, "status": { "enum": ["modeled", "insufficient-evidence"] } } },
    "lineOfSight": { "type": "object", "properties": { "schemaVersion": { "const": "wr-line-of-sight-v1" }, "status": { "enum": ["modeled", "indeterminate", "insufficient-evidence"] } } }
  }
}
