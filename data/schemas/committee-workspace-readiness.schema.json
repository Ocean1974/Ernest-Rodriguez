{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/committee-workspace-readiness.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "status", "contracts", "durableWorkspace", "approvalBoundary", "documentBoundary", "diligenceBoundary", "activation", "certificationScenario", "checks", "releaseBlockers"],
  "properties": {
    "schemaVersion": { "const": "wr-committee-workspace-readiness-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["foundation-ready-release-blocked", "rejected"] },
    "contracts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "durableWorkspace": { "type": "object" },
    "approvalBoundary": { "type": "object" },
    "documentBoundary": { "type": "object" },
    "diligenceBoundary": { "type": "object" },
    "activation": { "type": "object" },
    "certificationScenario": { "type": "object" },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "passed"] } },
    "releaseBlockers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
