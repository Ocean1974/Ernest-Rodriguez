{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/deal-room.schema.json",
  "title": "White Rabbit Deal Room and Document Evidence",
  "oneOf": [
    { "$ref": "#/$defs/room" }, { "$ref": "#/$defs/malwareScan" }, { "$ref": "#/$defs/documentVersion" },
    { "$ref": "#/$defs/share" }, { "$ref": "#/$defs/legalHold" }, { "$ref": "#/$defs/accessEvent" }, { "$ref": "#/$defs/deletionRequest" },
    { "$ref": "#/$defs/state" }, { "$ref": "#/$defs/citation" }, { "$ref": "#/$defs/citationVerification" }, { "$ref": "#/$defs/claim" },
    { "$ref": "#/$defs/extractionRun" }, { "$ref": "#/$defs/review" }, { "$ref": "#/$defs/promotion" }, { "$ref": "#/$defs/evidenceState" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "room": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "dealId", "whiteRabbitPropertyId", "name", "status", "createdByUserId", "createdAt", "roomSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-v1" }, "roomSha256": { "$ref": "#/$defs/digest" } } },
    "malwareScan": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "contentSha256", "engineId", "engineVersion", "definitionsVersion", "result", "threatNames", "scannedAt", "evidenceRef", "verificationStatus", "verificationPolicyId", "scannerAttestationSha256", "verifiedAt", "scanSha256"], "properties": { "schemaVersion": { "const": "wr-malware-scan-evidence-v1" }, "result": { "enum": ["clean", "infected", "error", "pending"] }, "scanSha256": { "$ref": "#/$defs/digest" } } },
    "documentVersion": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "roomId", "dealId", "whiteRabbitPropertyId", "documentId", "versionNumber", "logicalName", "fileName", "mediaType", "byteLength", "contentSha256", "objectRef", "classification", "uploadedByUserId", "uploadedAt", "malwareScan", "quarantineStatus", "supersedesVersionId", "versionSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-document-version-v1" }, "classification": { "enum": ["public", "internal", "confidential", "restricted"] }, "quarantineStatus": { "enum": ["released", "quarantined"] }, "versionSha256": { "$ref": "#/$defs/digest" } } },
    "share": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "roomId", "documentVersionIds", "recipientId", "recipientType", "clearance", "tokenSha256", "maxDownloads", "createdByUserId", "createdAt", "expiresAt", "revokedAt", "revokedByUserId", "revocationReason", "shareSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-share-v1" }, "tokenSha256": { "$ref": "#/$defs/digest" }, "shareSha256": { "$ref": "#/$defs/digest" } } },
    "legalHold": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "roomId", "documentId", "matterId", "reason", "issuedByUserId", "issuedAt", "status", "releasedAt", "releasedByUserId", "releaseReason", "holdSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-legal-hold-v1" }, "status": { "enum": ["active", "released"] } } },
    "accessEvent": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "roomId", "documentVersionId", "actorId", "actorType", "action", "outcome", "reasonCode", "shareId", "occurredAt", "eventSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-access-event-v1" }, "outcome": { "enum": ["allowed", "denied"] } } },
    "deletionRequest": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "documentId", "requestedByUserId", "reason", "status", "requestedAt", "deletionRequestSha256"], "properties": { "schemaVersion": { "const": "wr-deal-room-deletion-request-v1" }, "status": { "enum": ["pending-purge", "purged"] }, "deletionRequestSha256": { "$ref": "#/$defs/digest" } } },
    "state": { "type": "object", "required": ["schemaVersion", "organizationId", "revision", "rooms", "documentVersions", "shares", "legalHolds", "accessLog", "deletionRequests", "updatedAt"], "properties": { "schemaVersion": { "const": "wr-deal-room-state-v1" } } },
    "citation": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "documentVersionId", "documentVersionSha256", "pageNumber", "pageTextSha256", "startOffset", "endOffset", "boundingBox", "excerpt", "excerptSha256", "citationSha256"], "properties": { "schemaVersion": { "const": "wr-document-citation-v1" }, "citationSha256": { "$ref": "#/$defs/digest" } } },
    "citationVerification": { "type": "object", "required": ["schemaVersion", "citationId", "citationSha256", "organizationId", "documentVersionId", "documentVersionSha256", "pageTextSha256", "verifierId", "verifiedAt", "valid", "findings", "verificationSha256"], "properties": { "schemaVersion": { "const": "wr-document-citation-verification-v1" }, "valid": { "type": "boolean" }, "verificationSha256": { "$ref": "#/$defs/digest" } } },
    "claim": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "factPath", "value", "valueType", "status", "confidence", "citations", "unknownReason", "extractionNotes", "claimSha256"], "properties": { "schemaVersion": { "const": "wr-document-evidence-claim-v1" }, "status": { "enum": ["observed", "unknown", "conflicting"] }, "claimSha256": { "$ref": "#/$defs/digest" } } },
    "extractionRun": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "roomId", "dealId", "whiteRabbitPropertyId", "documentVersionId", "documentVersionSha256", "contentSha256", "extractorType", "extractorId", "modelId", "modelVersion", "promptSha256", "claims", "conflicts", "createdAt", "status", "runSha256"], "properties": { "schemaVersion": { "const": "wr-document-extraction-run-v1" }, "status": { "enum": ["review-required", "insufficient-evidence"] } } },
    "review": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "extractionRunId", "extractionRunSha256", "reviewerUserId", "reviewerRole", "decision", "claimDecisions", "reviewedAt", "reviewSha256"], "properties": { "schemaVersion": { "const": "wr-document-extraction-review-v1" }, "decision": { "enum": ["approved", "rejected", "changes-requested"] } } },
    "promotion": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "dealId", "whiteRabbitPropertyId", "factPath", "proposedValue", "valueType", "documentVersionId", "documentVersionSha256", "extractionRunId", "extractionRunSha256", "claimId", "claimSha256", "citationSha256s", "citationVerificationSha256s", "reviewId", "reviewSha256", "promotedByUserId", "promotedAt", "targetExpectedRevision", "status", "promotionSha256"], "properties": { "schemaVersion": { "const": "wr-reviewed-fact-promotion-v1" }, "status": { "const": "proposed-not-applied" } } },
    "evidenceState": { "type": "object", "required": ["schemaVersion", "organizationId", "revision", "extractionRuns", "reviews", "citationVerifications", "promotions", "updatedAt"], "properties": { "schemaVersion": { "const": "wr-document-evidence-state-v1" } } }
  }
}
