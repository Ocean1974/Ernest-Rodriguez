{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/transaction-diligence.schema.json",
  "title": "White Rabbit Transaction Diligence Orchestration",
  "oneOf": [
    { "$ref": "#/$defs/calendar" }, { "$ref": "#/$defs/templateTask" }, { "$ref": "#/$defs/template" },
    { "$ref": "#/$defs/evidence" }, { "$ref": "#/$defs/criticalDate" }, { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/history" }, { "$ref": "#/$defs/workflow" }, { "$ref": "#/$defs/sla" },
    { "$ref": "#/$defs/reminderJob" }, { "$ref": "#/$defs/reminderState" }, { "$ref": "#/$defs/reminderRun" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "calendar": { "type": "object", "required": ["schemaVersion", "id", "jurisdiction", "timeZone", "weekendDays", "holidays", "sourceAuthority", "sourceVersion", "sourceRef", "sourceAsOf", "validThrough", "calendarSha256"], "properties": { "schemaVersion": { "const": "wr-business-calendar-v1" }, "calendarSha256": { "$ref": "#/$defs/digest" } } },
    "templateTask": { "type": "object", "required": ["schemaVersion", "id", "title", "phase", "dependencyIds", "deadlineRule", "evidenceRequirements", "assigneeRole", "waivable", "critical", "reminderOffsetsSeconds", "escalationAfterSeconds", "taskSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-template-task-v1" }, "taskSha256": { "$ref": "#/$defs/digest" } } },
    "template": { "type": "object", "required": ["schemaVersion", "id", "version", "name", "transactionType", "jurisdiction", "tasks", "createdByUserId", "createdAt", "templateSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-checklist-template-v1" }, "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/templateTask" } }, "templateSha256": { "$ref": "#/$defs/digest" } } },
    "evidence": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "dealId", "workflowId", "taskId", "type", "evidenceRef", "evidenceSha256", "verifiedByUserId", "verificationPolicyId", "verifiedAt", "expiresAt", "receiptSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-evidence-receipt-v1" }, "type": { "enum": ["document-version", "fact-promotion", "approval", "inspection", "artifact"] }, "receiptSha256": { "$ref": "#/$defs/digest" } } },
    "criticalDate": { "type": "object", "required": ["schemaVersion", "taskId", "anchorId", "anchorDate", "localDueDate", "deadlineLocalTime", "timeZone", "dueAt", "status", "calendarId", "calendarSha256", "criticalDateSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-critical-date-v1" }, "status": { "enum": ["calculated", "unknown-anchor", "not-applicable"] }, "criticalDateSha256": { "$ref": "#/$defs/digest" } } },
    "task": { "type": "object", "required": ["schemaVersion", "id", "templateTaskSha256", "title", "phase", "dependencyIds", "evidenceRequirements", "assigneeRole", "assigneeUserId", "waivable", "critical", "reminderOffsetsSeconds", "escalationAfterSeconds", "criticalDate", "status", "completedAt", "completedByUserId", "evidenceReceipts", "taskInstanceSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-task-v1" }, "status": { "enum": ["blocked", "ready", "in-progress", "completed", "waived"] }, "taskInstanceSha256": { "$ref": "#/$defs/digest" } } },
    "history": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "workflowId", "taskId", "action", "fromStatus", "toStatus", "actorUserId", "reason", "evidenceReceiptSha256s", "occurredAt", "previousEventSha256", "eventSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-history-event-v1" }, "eventSha256": { "$ref": "#/$defs/digest" } } },
    "workflow": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "dealId", "whiteRabbitPropertyId", "templateId", "templateSha256", "calendarId", "calendarSha256", "anchors", "revision", "tasks", "history", "historyHeadSha256", "status", "createdByUserId", "createdAt", "updatedAt", "workflowSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-workflow-v1" }, "status": { "enum": ["active", "completed", "cancelled"] }, "workflowSha256": { "$ref": "#/$defs/digest" } } },
    "sla": { "type": "object", "required": ["schemaVersion", "organizationId", "workflowId", "workflowSha256", "evaluatedAt", "status", "findings", "reportSha256"], "properties": { "schemaVersion": { "const": "wr-diligence-sla-report-v1" }, "status": { "enum": ["on-track", "warning", "breached", "critical"] }, "reportSha256": { "$ref": "#/$defs/digest" } } },
    "reminderJob": { "type": "object", "required": ["schemaVersion", "id", "organizationId", "workflowId", "workflowSha256", "taskId", "kind", "scheduledAt", "recipientRef", "subscriptionId", "channelType", "providerId", "endpointRef", "payloadRef", "alertIdempotencyKey", "status", "attemptNumber", "maxAttempts", "nextAttemptAt", "lease", "alertDeliveryAttemptId", "lastErrorCode", "lastErrorMessage", "createdAt", "updatedAt", "emittedAt"], "properties": { "schemaVersion": { "const": "wr-diligence-reminder-job-v1" }, "status": { "enum": ["queued", "leased", "retry-scheduled", "emitted", "dead-lettered", "cancelled"] } } },
    "reminderState": { "type": "object", "required": ["schemaVersion", "organizationId", "revision", "jobs", "deadLetters", "updatedAt"], "properties": { "schemaVersion": { "const": "wr-diligence-reminder-worker-state-v1" } } },
    "reminderRun": { "type": "object", "required": ["schemaVersion", "organizationId", "workerId", "startedAt", "completedAt", "leasedJobIds", "emittedJobIds", "retryScheduledJobIds", "deadLetteredJobIds", "recoveredLeaseJobIds", "leaseReceipt", "completionReceipt"], "properties": { "schemaVersion": { "const": "wr-diligence-reminder-run-v1" } } }
  }
}
