{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://white-rabbit.local/schemas/parcel-query-result.schema.json",
  "title": "White Rabbit Parcel Query Result",
  "type": "object",
  "required": ["schemaVersion", "planVersion", "rawQuery", "totals", "matches", "indeterminate", "unsupported"],
  "properties": {
    "schemaVersion": { "const": "wr-parcel-query-result-v1" },
    "planVersion": { "type": "string" },
    "rawQuery": { "type": "string" },
    "totals": {
      "type": "object",
      "required": ["evaluated", "matched", "indeterminate", "rejected"],
      "properties": { "evaluated": { "type": "integer", "minimum": 0 }, "matched": { "type": "integer", "minimum": 0 }, "indeterminate": { "type": "integer", "minimum": 0 }, "rejected": { "type": "integer", "minimum": 0 } }
    },
    "matches": { "type": "array", "items": { "$ref": "#/$defs/evaluatedParcel" } },
    "indeterminate": { "type": "array", "items": { "$ref": "#/$defs/evaluatedParcel" } },
    "unsupported": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evaluatedParcel": {
      "type": "object",
      "required": ["parcel", "evaluation"],
      "properties": { "parcel": { "type": "object" }, "evaluation": { "type": "object" } }
    }
  }
}
