  "search_index_fields": ["countyParcelId", "HCAD_NUM", "acct_num", "LOWPARCELID", "GlobalID", "owner_name_1", "site_str_name", "site_city"],
  "qa_checks": ["parcel count", "missing geometry", "missing HCAD_NUM", "duplicate HCAD_NUM", "missing acct_num", "duplicate acct_num", "unique GlobalID"],
