    "centroid": { "type": "generated", "method": "polygon centroid from WGS84 GeoJSON geometry converted to screen point" },
    "points": { "type": "generated", "method": "simplified polygon ring converted to screen points" },
    "liveGeometry.center": { "type": "generated", "method": "polygon centroid as WGS84 longitude/latitude" },
    "liveGeometry.points": { "type": "generated", "method": "simplified polygon ring as WGS84 longitude/latitude" },
    "realGeometry": { "type": "generated", "method": "GeoJSON Feature geometry from Harris parcel polygon" },
