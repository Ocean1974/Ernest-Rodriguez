    "propertyAddress": { "type": "template", "value": "${site_str_pfx} ${site_str_num} ${site_str_num_sfx} ${site_str_name} ${site_str_sfx} ${site_str_sfx_dir}" },
    "city": { "type": "field", "sourceField": "site_city" },
    "propertyZip": { "type": "field", "sourceField": "site_zip" },
