{
  "id": "jefferson-ky-lojic-ingestion",
  "countyAdapter": "data/county-adapters/louisville/adapter.json",
  "universalParcelSchema": "data/schemas/universal-parcel.schema.json",
  "defaultMode": "plan",
  "steps": [
    {
      "id": "inspect-lojic-parcels",
      "label": "Inspect LOJIC parcel geometry schema and count",
      "command": "node scripts/build-jefferson-ky-lojic-parcels.cjs --qa-only",
      "requiredOutputs": [
        "output/jefferson-ky/schema-report.md",
        "output/jefferson-ky/schema-report.json",
        "output/jefferson-ky/qa-report.md",
        "output/jefferson-ky/qa-report.json"
      ]
    },
    {
      "id": "verify-pva-join",
      "label": "Build Jefferson County PVA owner/appraisal join index",
      "command": "node scripts/build-jefferson-ky-pva-owner-appraisal.cjs",
      "requiredOutputs": [
        "output/jefferson-ky/join-key-report.md",
        "output/jefferson-ky/pva-owner-appraisal-report.md",
        "output/jefferson-ky/pva-owner-appraisal-report.json",
        "output/jefferson-ky/jefferson-county-ky-pva-owner-appraisal-index.json"
      ]
    },
    {
      "id": "build-parcel-geojson",
      "label": "Build joined Jefferson County universal parcel GeoJSON",
      "command": "node scripts/build-jefferson-ky-lojic-parcels.cjs --full",
      "requiredOutputs": [
        "output/jefferson-ky/jefferson-county-ky-parcels.geojson",
        "output/jefferson-ky/full-parcel-access-report.md",
        "output/jefferson-ky/jefferson-county-ky-parcel-search-index.json",
        "output/jefferson-ky/jefferson-county-ky-parcel-search-index.csv"
      ]
    },
    {
      "id": "build-parcel-service",
      "label": "Build Jefferson County viewport parcel chunks and search shards",
      "command": "WR_COUNTY=louisville node scripts/build-app-parcel-service.cjs",
      "requiredOutputs": [
        "public/data/counties/jefferson-ky/parcels/manifest.json"
      ]
    },
    {
      "id": "build-owner-matches",
      "label": "Build Jefferson County owner/contact parcel matches",
      "command": "node scripts/build-jefferson-ky-pva-owner-appraisal.cjs",
      "requiredOutputs": [
        "output/jefferson-ky/jefferson-county-ky-pva-owner-appraisal-index.json",
        "output/jefferson-ky/pva-owner-appraisal-report.md"
      ]
    },
    {
      "id": "build-permit-service",
      "label": "Normalize and publish Louisville permit chunks",
      "command": "echo Add Louisville Metro permit source normalization after official source selection.",
      "requiredOutputs": [
        "public/data/counties/jefferson-ky/permits/manifest.json"
      ]
    },
    {
      "id": "build-development-intelligence",
      "label": "Build Jefferson County development signals and parcel development index",
      "command": "echo Add development intelligence after permits and parcel joins exist.",
      "requiredOutputs": [
        "public/data/counties/jefferson-ky/developments/parcel-development-index.json"
      ]
    },
    {
      "id": "build-address-index",
      "label": "Build Jefferson County LOJIC parcel address index",
      "command": "node scripts/build-jefferson-ky-address-index.cjs",
      "requiredOutputs": [
        "data/county-adapters/louisville/lojic-address-source-manifest.json",
        "public/data/counties/jefferson-ky/addresses/manifest.json",
        "output/jefferson-ky/address-source-report.md",
        "output/jefferson-ky/address-source-report.json"
      ]
    },
    {
      "id": "build-zoning-index",
      "label": "Build Jefferson County LOJIC zoning parcel index",
      "command": "node scripts/build-jefferson-ky-zoning-index.cjs",
      "requiredOutputs": [
        "data/county-adapters/louisville/lojic-zoning-source-manifest.json",
        "public/data/counties/jefferson-ky/zoning/manifest.json",
        "public/data/counties/jefferson-ky/zoning/parcel-zoning-index.json",
        "output/jefferson-ky/zoning-source-report.md",
        "output/jefferson-ky/zoning-source-report.json"
      ]
    },
    {
      "id": "build-floodplain-index",
      "label": "Build Jefferson County FEMA flood zone parcel index",
      "command": "node scripts/build-jefferson-ky-floodplain-index.cjs",
      "requiredOutputs": [
        "data/county-adapters/louisville/fema-floodplain-source-manifest.json",
        "public/data/counties/jefferson-ky/floodplain/manifest.json",
        "public/data/counties/jefferson-ky/floodplain/parcel-floodplain-index.json",
        "output/jefferson-ky/floodplain-source-report.md",
        "output/jefferson-ky/floodplain-source-report.json"
      ]
    },
    {
      "id": "validate",
      "label": "Run Jefferson County pilot QC",
      "command": "npm.cmd run county:qc",
      "requiredOutputs": [
        "output/county-qc/jefferson-ky.json",
        "output/county-qc/jefferson-ky.md"
      ]
    }
  ],
  "productionTileStep": {
    "id": "build-pmtiles",
    "label": "Build Jefferson County PMTiles/vector tiles after the parcel GeoJSON exists",
    "handoff": "output/jefferson-ky/vector-tiles/README.md",
    "script": "output/jefferson-ky/vector-tiles/build-jefferson-ky-pmtiles.ps1",
    "expectedOutput": "output/jefferson-ky/jefferson-county-ky-parcels.pmtiles"
  },
  "uiConstraint": "Do not redesign or restyle any White Rabbit pages while running this pilot county ingestion pipeline.",
  "pipelineContract": {
    "mode": "evidence-gated",
    "sourcePriority": "official assessor/appraiser, county GIS, municipal, state, or federal sources first",
    "identityRule": "Do not emit countyParcelId until a complete duplicate-safe source key or documented composite key is proven.",
    "geometryRule": "Preprocess county geometry at build time and publish viewport chunks, search shards, or PMTiles.",
    "failurePolicy": "Preserve exact source, emitted, skipped, unmatched, duplicate, and null counts; never hide a discrepancy.",
    "activationRule": "Keep the county disabled until its individual map/search, owner/appraisal, QC, and activation gates pass."
  }
}