{
  "county_id": "jefferson-ky",
  "adapter_id": "jefferson-ky",
  "schema_version": "wr-universal-parcel-v1",
  "source": "LOJIC Jefferson County KY Parcels",
  "source_url": "https://gis.lojic.org/maps/rest/services/LojicSolutions/OpenDataPVA/MapServer/1",
  "source_spatial_reference": "EPSG:2246 / NAD 1983 StatePlane Kentucky North FIPS 1601 Feet",
  "ingestion_geometry_out_sr": 4326,
  "unique_gis_key": "LRSN",
  "parcel_id_field": "PARCELID",
  "parcel_filter": "PARCEL_TYPE = 0",
  "field_map": {
    "schemaVersion": { "type": "constant", "value": "wr-universal-parcel-v1" },
    "sourceCountyId": { "type": "constant", "value": "jefferson-ky" },
    "countyParcelId": { "type": "template", "value": "jefferson-ky:${LRSN}" },
    "sourceParcelId": { "type": "field", "sourceField": "PARCELID" },
    "accountNum": { "type": "field", "sourceField": "PARCELID" },
    "accountNumber": { "type": "field", "sourceField": "PARCELID" },
    "gisParcelId": { "type": "field", "sourceField": "LRSN" },
    "address": { "type": "placeholder", "value": "" },
    "propertyAddress": { "type": "placeholder", "value": "" },
    "city": { "type": "constant", "value": "Louisville" },
    "propertyZip": { "type": "placeholder", "value": "" },
    "propertyName": { "type": "template", "value": "LOJIC Parcel ${PARCELID}" },
    "ownerName": { "type": "placeholder", "value": "" },
    "ownerName2": { "type": "placeholder", "value": "" },
    "businessName": { "type": "placeholder", "value": "" },
    "ownerMailingAddress": { "type": "placeholder", "value": "" },
    "ownerMailingAddress2": { "type": "placeholder", "value": "" },
    "ownerCity": { "type": "placeholder", "value": "" },
    "ownerState": { "type": "placeholder", "value": "" },
    "ownerZip": { "type": "placeholder", "value": "" },
    "ownerPhone": { "type": "placeholder", "value": "" },
    "ownerEmail": { "type": "placeholder", "value": "" },
    "landAreaSqFt": { "type": "field", "sourceField": "SHAPE.AREA" },
    "areaLabel": { "type": "template", "value": "${SHAPE.AREA} source square feet" },
    "perimeter": { "type": "field", "sourceField": "SHAPE.LEN" },
    "centroid": { "type": "generated", "method": "polygon centroid from WGS84 GeoJSON geometry converted to screen point" },
    "points": { "type": "generated", "method": "simplified polygon ring converted to screen points" },
    "liveGeometry.center": { "type": "generated", "method": "polygon centroid as WGS84 longitude/latitude" },
    "liveGeometry.points": { "type": "generated", "method": "simplified polygon ring as WGS84 longitude/latitude" },
    "realGeometry": { "type": "generated", "method": "GeoJSON Feature geometry from LOJIC parcel polygon" },
    "joins.pvaOwnerAppraisal": { "type": "placeholder", "value": false },
    "sourceReferences.lojic.OBJECTID": { "type": "field", "sourceField": "OBJECTID" },
    "sourceReferences.lojic.LRSN": { "type": "field", "sourceField": "LRSN" },
    "sourceReferences.lojic.PARCELID": { "type": "field", "sourceField": "PARCELID" },
    "sourceReferences.lojic.PARCEL_TYPE": { "type": "field", "sourceField": "PARCEL_TYPE" },
    "sourceReferences.lojic.PIN": { "type": "field", "sourceField": "PIN" },
    "sourceReferences.lojic.SHAPE_AREA": { "type": "field", "sourceField": "SHAPE.AREA" },
    "sourceReferences.lojic.SHAPE_LEN": { "type": "field", "sourceField": "SHAPE.LEN" }
  },
  "search_index_fields": ["countyParcelId", "PARCELID", "LRSN"],
  "qa_checks": ["parcel count", "missing geometry", "duplicate LRSN", "duplicate PARCELID"],
  "owner_appraisal_placeholder_hook": {
    "status": "join-ready-source-needed",
    "expected_source": "Jefferson County PVA owner/appraisal export",
    "manifest": "data/county-adapters/louisville/pva-owner-appraisal-source-manifest.json",
    "builder": "scripts/build-jefferson-ky-pva-owner-appraisal.cjs",
    "index": "output/jefferson-ky/jefferson-county-ky-pva-owner-appraisal-index.json",
    "candidate_join_keys": ["PARCELID", "LRSN", "PIN"],
    "primary_join": "PVA PARCELID -> LOJIC PARCELID -> White Rabbit accountNum",
    "secondary_join": "PVA LRSN -> LOJIC LRSN -> White Rabbit gisParcelId",
    "blocked_until": "Official PVA owner/appraisal export is added to data/raw/jefferson-ky/Jefferson_County_KY_PVA_Owner_Appraisal.csv"
  }
}
