{
  "id": "dallas-county-dcad-ingestion",
  "countyAdapter": "data/county-adapters/dallas/adapter.json",
  "universalParcelSchema": "data/schemas/universal-parcel.schema.json",
  "defaultMode": "plan",
  "steps": [
    {
      "id": "inspect-sources",
      "label": "Inspect source schemas and join keys",
      "command": "node scripts/build-pipeline-artifacts.cjs",
      "requiredOutputs": [
        "output/schema-report.md",
        "output/schema-report.json",
        "output/join-key-report.md"
      ]
    },
    {
      "id": "build-parcel-geojson",
      "label": "Build joined universal parcel GeoJSON",
      "command": "node scripts/build-white-rabbit-dallas-parcels.cjs",
      "requiredOutputs": [
        "output/white-rabbit-dallas-parcels.geojson",
        "output/white-rabbit-dallas-parcels-manifest.json",
        "output/full-parcel-access-report.md"
      ]
    },
    {
      "id": "build-parcel-service",
      "label": "Build viewport parcel chunks and search shards",
      "command": "node scripts/build-app-parcel-service.cjs",
      "requiredOutputs": [
        "public/data/parcels/manifest.json",
        "public/data/parcels/search-index.json"
      ]
    },
    {
      "id": "build-owner-matches",
      "label": "Build owner/contact parcel matches",
      "command": "node scripts/build-parcel-owner-matches.cjs",
      "requiredOutputs": [
        "output/parcel-owner-matches.json",
        "output/parcel-owner-match-report.md"
      ]
    },
    {
      "id": "fetch-permits",
      "label": "Fetch official permit and CO source data",
      "command": "node scripts/fetch-dallas-permits.ts",
      "requiresNetwork": true,
      "requiredOutputs": [
        "data/permits/raw/e7gq-4sah.json",
        "data/permits/raw/9qet-qt9e.json"
      ]
    },
    {
      "id": "build-permit-service",
      "label": "Normalize and publish permit chunks",
      "command": "node scripts/build-permit-output.ts",
      "requiredOutputs": [
        "public/data/permits/manifest.json",
        "output/dcad-permit-join-method-report.md"
      ]
    },
    {
      "id": "build-development-intelligence",
      "label": "Build development signals and parcel development index",
      "commands": [
        "node scripts/build-development-intelligence.cjs",
        "node scripts/build-development-parcel-index.cjs"
      ],
      "requiredOutputs": [
        "output/development-intelligence.json",
        "output/development-intelligence-report.md",
        "public/data/developments/parcel-development-index.json"
      ]
    },
    {
      "id": "build-zoning-layer-manifest",
      "label": "Inspect Dallas zoning sources and publish safe optional-layer manifest",
      "command": "node scripts/build-dallas-zoning-manifest.cjs",
      "requiresNetwork": true,
      "requiredOutputs": [
        "output/dallas-zoning-source-report.md",
        "output/dallas-zoning-source-report.json",
        "public/data/zoning/manifest.json"
      ]
    },
    {
      "id": "build-parcel-zoning-index",
      "label": "Join Dallas zoning, PD, SUP, and subdistrict records back to parcel IDs",
      "command": "node scripts/build-dallas-parcel-zoning-index.cjs",
      "requiresNetwork": true,
      "requiredOutputs": [
        "output/dallas-parcel-zoning-index-report.md",
        "output/dallas-parcel-zoning-index-report.json",
        "public/data/zoning/parcel-zoning-index.json"
      ]
    },
    {
      "id": "build-parcel-floodplain-index",
      "label": "Join Dallas floodplain polygons back to parcel IDs",
      "command": "node scripts/build-dallas-parcel-floodplain-index.cjs",
      "requiresNetwork": true,
      "requiredOutputs": [
        "output/dallas-parcel-floodplain-index-report.md",
        "output/dallas-parcel-floodplain-index-report.json",
        "public/data/floodplain/manifest.json",
        "public/data/floodplain/parcel-floodplain-index.json"
      ]
    },
    {
      "id": "build-parcel-intelligence-report",
      "label": "Publish parcel ID intelligence readiness report",
      "command": "node scripts/build-dallas-parcel-intelligence-report.cjs",
      "requiredOutputs": [
        "output/dallas-parcel-intelligence-report.md",
        "output/dallas-parcel-intelligence-report.json"
      ]
    },
    {
      "id": "validate",
      "label": "Run ingestion and app plumbing tests",
      "command": "npm.cmd test",
      "requiredOutputs": [
        "output/dcad-completion-report.md",
        "output/dcad-county-adapter-report.md"
      ]
    },
    {
      "id": "build-app",
      "label": "Build app without changing page visuals",
      "command": "npm.cmd run build",
      "requiredOutputs": [
        "dist/index.html"
      ]
    }
  ],
  "productionTileStep": {
    "id": "build-pmtiles",
    "label": "Build PMTiles/vector tiles outside this workspace when Tippecanoe, PMTiles, or Docker is available",
    "handoff": "output/vector-tiles/README.md",
    "script": "output/vector-tiles/build-dcad-pmtiles.ps1",
    "expectedOutput": "output/white-rabbit-dallas-parcels.pmtiles"
  },
  "uiConstraint": "Do not redesign or restyle any White Rabbit pages while running this county ingestion pipeline.",
  "pipelineContract": {
    "mode": "evidence-gated",
    "sourcePriority": "official assessor/appraiser, county GIS, municipal, state, or federal sources first",
    "identityRule": "Do not emit countyParcelId until a complete duplicate-safe source key or documented composite key is proven.",
    "geometryRule": "Preprocess county geometry at build time and publish viewport chunks, search shards, or PMTiles.",
    "failurePolicy": "Preserve exact source, emitted, skipped, unmatched, duplicate, and null counts; never hide a discrepancy.",
    "activationRule": "Keep the county disabled until its individual map/search, owner/appraisal, QC, and activation gates pass."
  }
}