    { "feature": "Development feasibility", "capabilityId": "optional-3d-development-analysis", "requiredCountyData": ["parcel-geometry", "dimensions", "zoning", "terrain", "building-context"] },
    { "feature": "Ownership intelligence", "capabilityId": "canonical-property-intelligence", "requiredCountyData": ["owner-appraisal", "deeds", "licensed-entity-records", "canonical-parcel-id"] },
    { "feature": "Monitoring and alerts", "capabilityId": "real-time-monitoring-alerts", "requiredCountyData": ["versioned-sources", "freshness-policy", "change-events", "canonical-parcel-id"] },
